# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/careconnect

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# AI (local LLM via Ollama -- no API key needed)
# Install Ollama (https://ollama.com), then: ollama pull llama3.1
# If Ollama isn't running or the model isn't pulled, classification falls
# back to a built-in heuristic automatically -- the app still works either way.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
